# .env.example
POSTGRES_DB=plan2space
POSTGRES_USER=p2s
POSTGRES_PASSWORD=change_me_dev_only
REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=p2s
RABBITMQ_DEFAULT_PASS=change_me_dev_only
MINIO_ROOT_USER=p2s_minio
MINIO_ROOT_PASSWORD=change_me_dev_only
JWT_SECRET=dev_secret_replace_in_prod_min_32_chars
ASPNETCORE_ENVIRONMENT=Development
AI_INTERNAL_URL=http://ai:8000
P2S_INTERNAL_TOKEN=dev_internal_token_change_me
# Co-pilot LLM (leave the key empty to disable the co-pilot)
OPENAI_API_KEY=
COPILOT_MODEL=gpt-4o-mini
COPILOT_BASE_URL=
# First admin: the API creates (or promotes) this account at startup. Leave empty to skip.
P2S_ADMIN_EMAIL=
P2S_ADMIN_PASSWORD=
# Host port for the public nginx entrypoint
P2S_HTTP_PORT=80
